      }
    },
    {
      "name": "4b. Filtros combinados",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/api/partners?Search=ana&Type=CUSTOMER&IncludeInactive=true&Page=1&PageSize=5",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "partners"
          ],
          "query": [
