              "pm.collectionVariables.set('version', j.Version);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Desativar via PUT (200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{host}}/api/partners/{{id}}",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "partners",
            "{{id}}"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Name\": \"Ana Silva\",\n  \"TaxNumber\": \"001234568\",\n  \"Type\": \"BOTH\",\n  \"Email\": null,\n  \"CreditLimit\": 2000,\n  \"IsActive\": false,\n  \"Version\": \"{{version}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.collectionVariables.set('id', j.Id);",
              "pm.collectionVariables.set('version', j.Version);"
            ]
          }
        }
      ]
    },
    {
      "name": "3b. PUT com versão antiga (409)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{host}}/api/partners/{{id}}",
          "host": [
            "{{host}}"
