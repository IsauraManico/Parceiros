{
  "info": {
    "name": "API Parceiros",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:5176"
    },
    {
      "key": "id",
      "value": ""
    },
    {
      "key": "version",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Criar cliente (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{host}}/api/partners",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "partners"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Name\": \"  Ana Silva  \",\n  \"TaxNumber\": \"001.234.568\",\n  \"Type\": \"CUSTOMER\",\n  \"Email\": \"ana@exemplo.pt\",\n  \"CreditLimit\": 1500.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.collectionVariables.set('id', j.Id);",
              "pm.collectionVariables.set('version', j.Version);"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. NIF duplicado (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{host}}/api/partners",
          "host": [
            "{{host}}"
          ],
          "path": [
            "api",
            "partners"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"Name\": \"Outra\",\n  \"TaxNumber\": \"001 234 568\",\n  \"Type\": \"SUPPLIER\",\n  \"CreditLimit\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Obter por Id (200)",
      "request": {
        "method": "GET",
        "header": [],
